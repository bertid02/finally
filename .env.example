# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# If not set, the built-in market simulator is used (recommended for most users).
# Note: the free Basic tier has no snapshot access — the backend will report this
# and you should fall back to the simulator by leaving this empty.
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Note: FINALLY_DB_PATH and FINALLY_STATIC_DIR are baked into the Docker image
# (/app/db/finally.db and /app/static) and do not belong here. Set them only when
# running the backend directly with `uv run uvicorn app.main:app`.
